#:import dp kivy.metrics.dp
#:import Video kivy.uix.video.Video

<RootLayout@FloatLayout>:
    canvas.before:
        Rectangle:
            source: "" if app.bg_is_video else app.bg_source
            pos: self.pos
            size: self.size

    Video:
        source: app.bg_source if app.bg_is_video else ""
        state: 'play' if app.bg_is_video else 'stop'
        options: {'eos': 'loop'}
        allow_stretch: True
        keep_ratio: False
        pos: self.pos
        size: self.size
        volume: 0
        opacity: 1 if app.bg_is_video else 0

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(30)
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        size_hint: (0.9, 0.9)
        
        MDLabel:
            id: main_label
            text: app.main_text
            halign: "left"
            font_style: "H3"
            theme_text_color: "Custom"
            text_color: (1, 1, 1, 1)

        Image:
            source: app.center_source
            size_hint: (None, None)
            size: (dp(170), dp(170)) if app.center_source else (0, 0)
            halign: "center"
            pos_hint: {"center_x": 0.5}
            opacity: 1 if app.center_source else 0

        MDCard:
            id: user_info_card
            orientation: "vertical"
            size_hint: (None, None)
            size: (dp(800), dp(150))
            padding: (dp(20), dp(20))
            pos_hint: {"center_x": 0.5}
            elevation: 10
            opacity: 0

            MDLabel:
                id: user_info_label
                text: ""
                halign: "center"
                font_style: "H5"
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1)

        MDBoxLayout:
            orientation: "horizontal"
            spacing: dp(20)
            pos_hint: {"center_x": 0.5}

            MDRaisedButton:
                text: "Charge credit"
                size_hint: (1, 1)
                md_bg_color: app.theme_cls.primary_color
                font_size: "32sp"
                on_release: app.show_charge_dialog(self)

            MDRaisedButton:
                text: "Show credit"
                size_hint: (1, 1)
                md_bg_color: app.theme_cls.accent_color
                font_size: "32sp"
                on_release: app.show_credit_dialog(self)

    MDLabel:
        text: app.version_text
        halign: "right"
        valign: "bottom"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 0.7)
        font_style: "Caption"
        size_hint: (None, None)
        size: self.texture_size
        text_size: (None, None)
        pos_hint: {"right": 0.98, "y": 0.02}
        on_touch_down: app.on_version_tap(self, args[1])

<ErrorLayout@MDBoxLayout>:
    orientation: "vertical"
    padding: dp(20)
    spacing: dp(20)

    MDLabel:
        text: app.error_text
        halign: "center"
        font_style: "H5"

<ChargeDialogContent@MDBoxLayout>:
    orientation: "vertical"    
    spacing: dp(20)
    padding: dp(20)
    size_hint_y: None
    height: self.minimum_height    

    MDLabel:
        text: "Select amount to charge"
        font_style: "H5"
        halign: "center"
        size_hint_y: None

    MDBoxLayout:
        orientation: "horizontal"
        halign: "center"
        spacing: dp(10)
        size_hint_y: None

        MDRaisedButton:
            text: "-"
            font_style: "H5"
            size_hint_x: 0.2
            size_hint_y: 0.5
            on_release: app.change_charge_amount(-1)

        MDLabel:
            text: str(app.charge_amount)
            font_style: "H4"
            halign: "center"
            size_hint_x: 0.5
            size_hint_y: None
            size: self.texture_size

        MDRaisedButton:
            text: "+"
            font_style: "H5"
            size_hint_x: 0.2
            size_hint_y: 0.5
            on_release: app.change_charge_amount(1)

        MDRaisedButton:
            text: "+10"
            font_style: "H5"
            size_hint_x: 0.2
            size_hint_y: 0.5
            on_release: app.change_charge_amount(10)
    
    MDBoxLayout:
        orientation: "vertical"    
        height: dp(50)
        size_hint_y: None

<WaitCardDialogContent@MDBoxLayout>:
    orientation: "vertical"
    spacing: dp(20)
    padding: dp(20)
    size_hint_y: None
    height: self.minimum_height

    MDLabel:
        text: app.wait_prompt_text
        halign: "center"
        font_style: "H5"
